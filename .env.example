# Copy to .env (gitignored). Everything is optional for local development.

# Assistant brain (free): Gemini key from https://aistudio.google.com/apikey
# (the fake phone also reuses a key already pasted into prototype/.env)
LLM_PROVIDER=gemini
LLM_API_KEY=paste-your-key-here
# LLM_MODEL=gemini-2.5-flash

