# Settings for the texting assistant (app/). Locally: copy to .env (gitignored); everything
# is optional for local development. On Railway: paste these as service variables.
# Never commit real values.

# --- AI (required for answers) ----------------------------------------------
# Gemini key: https://aistudio.google.com/apikey
# (the fake phone also reuses a key already pasted into prototype/.env)
# Note: on Google's free tier, prompts may be used to improve their models. With real
# student data, turn on billing for the key (cents at beta scale) so they aren't.
LLM_PROVIDER=gemini
LLM_API_KEY=
# LLM_MODEL=gemini-flash-lite-latest

# --- Deployed only --------------------------------------------------------------
# Railway fills DATABASE_URL in when you add Postgres (reference ${{Postgres.DATABASE_URL}}).
# Locally it defaults to SQLite in data/app.db.
# DATABASE_URL=

# Encrypts students' calendar links. Required with Postgres. Generate once and keep it safe
# (losing it means every student has to reconnect):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# The public https address of the app (connect links and Twilio signatures depend on it).
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# Morning texts, reminders and background syncs.
# RUN_SCHEDULER=true

# --- Twilio (real texting) --------------------------------------------------------
# Without these, texts stay queued for the local fake phone (run_dev.bat).
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# or, instead of a from number:
# TWILIO_MESSAGING_SERVICE_SID=MG...
