# Copy to prototype/.env (gitignored) and fill in. Never commit .env.
#
# Free options (pick one):
#   gemini  - Google AI Studio free tier. Key: https://aistudio.google.com/apikey
#             Note: free-tier prompts may be used by Google to improve models.
#   groq    - Groq free tier. Key: https://console.groq.com/keys
#   ollama  - fully local, no key. Install from https://ollama.com, then: ollama pull qwen2.5:7b
#   custom  - any other OpenAI-compatible endpoint (set LLM_BASE_URL + LLM_MODEL)

LLM_PROVIDER=gemini
LLM_API_KEY=paste-your-key-here

# Optional overrides (model names change over time; check your provider's model list)
# LLM_MODEL=gemini-flash-lite-latest
# LLM_BASE_URL=
# ASSISTANT_TIMEZONE=America/Toronto
